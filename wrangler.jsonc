{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mini-project-react-weather",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
